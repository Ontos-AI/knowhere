{
  "$defs": {
    "ChunkMetadata": {
      "additionalProperties": true,
      "properties": {
        "connect_to": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/Connection"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connect To"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Path"
        },
        "keywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keywords"
        },
        "length": {
          "minimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "page_assets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PageAsset"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Assets"
        },
        "page_nums": {
          "items": {
            "type": "integer"
          },
          "title": "Page Nums",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        }
      },
      "required": [
        "length",
        "summary",
        "page_nums"
      ],
      "title": "ChunkMetadata",
      "type": "object"
    },
    "ChunkRecord": {
      "additionalProperties": true,
      "properties": {
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ChunkMetadata"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "image",
            "table",
            "page"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "type",
        "content",
        "path",
        "metadata"
      ],
      "title": "ChunkRecord",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": true,
      "properties": {
        "keywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keywords"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "same_as_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Same As Owner"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "relation"
      ],
      "title": "Connection",
      "type": "object"
    },
    "PageAsset": {
      "additionalProperties": true,
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "asset_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Url"
        },
        "content_type": {
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "page_num": {
          "exclusiveMinimum": 0,
          "title": "Page Num",
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "page_num",
        "artifact_ref",
        "content_type",
        "source"
      ],
      "title": "PageAsset",
      "type": "object"
    },
    "Position": {
      "additionalProperties": true,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Position",
      "type": "object"
    }
  },
  "$id": "https://knowhereto.ai/contracts/parse_result/v1/chunks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "chunks": {
      "items": {
        "$ref": "#/$defs/ChunkRecord"
      },
      "title": "Chunks",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "chunks"
  ],
  "title": "Chunks",
  "type": "object"
}
