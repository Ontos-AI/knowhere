# Supply test-authorized model credentials through the remote secret channel.
# Never copy a production DATABASE_URL, Redis URL, bucket, or queue configuration.
DS_KEY=
DS_URL=https://api.deepseek.com/v1
NORMOL_MODEL=deepseek-flash
HIERARCHY_LLM_MODEL=deepseek-flash
IMAGE_MODEL=deepseek-flash
ASSET_MODEL=
VERCEL_KEY=
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIM=3072
EMBEDDING_ENDPOINT=https://ai-gateway.vercel.sh/v1/embeddings
PAGE_MEMORY_FINE_TEXT_EXTRACTOR=none

# Needed only if the selected retrieval harness or model provider uses them.
CURSOR_API_KEY=
GPT_API_KEY=
ALI_API_KEYS=
# Must match the endpoint/region of the selected Ali API key pool.
ALI_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARK_API_KEY=
GLM_API_KEY=

# Use emulator-only credentials from the isolated QStash dev service.
# Keep credentials blank only when testing with job webhooks omitted.
WEBHOOK_MASTER_KEY=
QSTASH_TOKEN=
QSTASH_BASE_URL=http://qstash:8080
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_CALLBACK_BASE_URL=http://knowhere-api:5005/api/v1
