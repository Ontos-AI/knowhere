# Set these after checking the Windows host's existing listeners.
E2E_BIND_ADDRESS=127.0.0.1
E2E_API_PORT=15005
E2E_S3_PORT=14566
E2E_NETWORK_NAME=knowhere-progressive-e2e

# Prefer an absolute private path outside the source/build context on Windows.
E2E_RUNTIME_ENV_PATH=./runtime.env
E2E_ARTIFACT_DIR=./artifacts

# Generate each independently with secrets.token_hex(24); do not reuse them.
E2E_POSTGRES_PASSWORD=
E2E_RUNTIME_PASSWORD=

# Before local Hipo integration, replace this with a URL reachable from both
# Windows containers and Hipo. Presigned upload/result URLs retain this host.
# For an initial test launched inside the Compose network, storage:4566 works.
E2E_S3_ENDPOINT_URL=http://storage:4566
